{
  "name": "bluebeam-copilot-reviewer",
  "version": "1.0.0",
  "description": "AI-assisted PDF review tool integrating Bluebeam with Claude/GPT for automated document analysis",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "review": "node src/cli/review.js",
    "batch": "node src/cli/batch-review.js",
    "scheduler": "node src/scheduler.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "tsc",
    "docker:build": "docker build -t bluebeam-copilot-reviewer .",
    "docker:run": "docker run -p 3000:3000 bluebeam-copilot-reviewer"
  },
  "keywords": [
    "bluebeam",
    "pdf",
    "ai",
    "review",
    "claude",
    "openai",
    "automation",
    "architecture",
    "engineering",
    "construction"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "pdf-parse": "^1.1.1",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.5.0",
    "anthropic": "^0.13.0",
    "openai": "^4.12.0",
    "node-cron": "^3.0.2",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "yargs": "^17.7.2",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "@types/node": "^20.8.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
